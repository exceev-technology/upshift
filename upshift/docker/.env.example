# For Docker Compose on a host without Coolify. In Coolify, set these as the resource's environment variables instead.
COMPOSE_PROJECT_NAME=upshift
# Drop docker-compose.local.yml to use an existing Postgres and Redis, and publish port 3000 yourself
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

TAG=latest
UPSHIFT_PORT=3000

SERVER_URL=http://localhost:3000
# FRONTEND_URL= # defaults to SERVER_URL
# Every workspace origin that calls the API with the session cookie, for example with multi-workspace subdomains
# AUTH_COOKIE_ALLOWED_ORIGINS=https://acme.crm.client-domain.com,https://globex.crm.client-domain.com
# IS_MULTIWORKSPACE_ENABLED=false
# DEFAULT_SUBDOMAIN=app

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY= # previous ENCRYPTION_KEY during a rotation
# Coolify generates SERVICE_BASE64_32_SECRET; it becomes APP_SECRET, which ENCRYPTION_KEY falls back to when empty
SERVICE_BASE64_32_SECRET=

PG_DATABASE_HOST=db
# PG_DATABASE_PORT=5432
POSTGRES_DB=upshift
SERVICE_USER_POSTGRES=postgres
SERVICE_PASSWORD_POSTGRES=replace_me_with_a_strong_password_without_special_characters

REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_USER=default
# REDIS_PASSWORD=

# Origins Traefik (Coolify's proxy) answers CORS for; not used without Traefik, but it must not be empty
TRAEFIK_CORS_ORIGIN_REGEX='^https://([a-z0-9-]+\.)?client-domain\.com$'

STORAGE_TYPE=local
# STORAGE_TYPE=s_3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com # required, also on AWS
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=crm@client-domain.com
# EMAIL_FROM_NAME=Upshift
# EMAIL_SMTP_HOST=smtp.client-domain.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
